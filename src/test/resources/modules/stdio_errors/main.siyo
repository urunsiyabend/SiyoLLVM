import "std/io"

fn main() {
    try { io.readFile("missing.txt") } catch e { println("1 " + e) }
    try { io.readLines("missing.txt") } catch e { println("2 " + e) }
    try { io.readFile("sub") } catch e { println("3 " + e) }
    try { io.readLines("sub/") } catch e { println("4 " + e) }
    try { io.writeFile("no/such/dir.txt", "x") } catch e { println("5 " + e) }
    try { io.appendFile("no/such/dir.txt", "x") } catch e { println("6 " + e) }
    try { io.writeFile("sub", "x") } catch e { println("7 " + e) }
    try { io.appendFile("sub", "x") } catch e { println("8 " + e) }
    try { io.writeFile("sub/f.txt/x", "x") } catch e { println("9 " + e) }
    try { io.readFile("") } catch e { println("10 " + e) }
    try { io.readFile("sub//f.txt/") } catch e { println("11 " + e) }
    try { io.readFile("sub//nope///") } catch e { println("12 " + e) }
    try { io.readFile("a\0b") } catch e { println("13 " + e) }
    try { io.writeFile("a\0b", "x") } catch e { println("14 " + e) }
    try { io.readFile("ç.txt") } catch e { println("15 " + e) }
    println(io.exists("a\0b") + " " + io.isFile("a\0b") + " " + io.isDir("a\0b") + " " + io.delete("a\0b"))
    println(io.listDir("a\0b"))
    println(io.readFile("sub//f.txt"))
    mut caught = try { io.readFile("missing.txt") } catch e { "caught: " + e }
    println(caught)
    println("before the uncaught one")
    io.readLines("still-missing.txt")
    println("not reached")
}
