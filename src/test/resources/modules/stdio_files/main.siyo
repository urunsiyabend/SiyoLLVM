import "std/io"

fn show(label: string, s: string) {
    println(label + " [" + s + "] " + toString(len(s)))
}

fn main() {
    // Line endings: CRLF, CR only, no final newline; LF with a final newline.
    println(io.readLines("crlf.txt"))
    show("crlf", io.readFile("crlf.txt"))
    println(io.readLines("lf.txt"))
    show("lf", io.readFile("lf.txt"))
    println(len(io.readLines("blank.txt")))
    show("blank", io.readFile("blank.txt"))
    // An empty file.
    show("empty", io.readFile("empty.txt"))
    println(len(io.readLines("empty.txt")))
    // Invalid UTF-8 decodes to U+FFFD, as Java's decoder replaces it.
    show("bad", io.readFile("bad.txt"))
    // Sequences cut short by the end of the file: E0 A0, F0 90 80, F5 80,
    // F5 80 80, 41 F5 80, F7 BF (a lead past F4 is one malformed byte).
    show("eof1", io.readFile("eof1.bin"))
    show("eof2", io.readFile("eof2.bin"))
    show("eof3", io.readFile("eof3.bin"))
    show("eof4", io.readFile("eof4.bin"))
    show("eof5", io.readFile("eof5.bin"))
    show("eof6", io.readFile("eof6.bin"))

    // writeFile creates and overwrites; appendFile appends, creating the file.
    io.writeFile("out.txt", "first version, long")
    io.writeFile("out.txt", "ab")
    io.appendFile("out.txt", "cd\n")
    io.appendFile("new.txt", "made by append")
    show("out", io.readFile("out.txt"))
    show("new", io.readFile("new.txt"))
    // Non-ASCII text round-trips; a lone surrogate is written as '?'.
    io.writeFile("text.txt", "héllo wörld 😀\n" + "lone " + chr(55296) + " end")
    println(io.readLines("text.txt"))
    show("text", io.readFile("text.txt"))

    // A Unicode file name (under LC_ALL=C, Java writes each non-ASCII code point as '?').
    io.mkdir("names")
    io.writeFile("names/ç ü.txt", "unicode name")
    println(io.exists("names/ç ü.txt"))
    show("uname", io.readFile("names/ç ü.txt"))
    println(io.listDir("names"))
    // A supplementary character is one '?' too.
    io.mkdir("emoji")
    io.writeFile("emoji/😀x.txt", "emoji name")
    println(io.exists("emoji/😀x.txt") + " " + io.exists("emoji/?x.txt") + " " + io.exists("emoji/??x.txt"))
    show("ename", io.readFile("emoji/😀x.txt"))
    println(io.listDir("emoji"))

    // Queries.
    println(io.exists("lf.txt") + " " + io.exists("nope.txt") + " " + io.exists("sub") + " " + io.exists(""))
    println(io.isFile("lf.txt") + " " + io.isFile("sub") + " " + io.isFile("nope"))
    println(io.isDir("lf.txt") + " " + io.isDir("sub") + " " + io.isDir("nope") + " " + io.isDir("sub/"))
    println(io.listDir("sub/inner"))
    println(len(io.listDir("sub")))
    println(io.listDir("missing"))
    println(io.listDir("lf.txt"))

    // mkdir makes parents; delete removes files and empty directories only.
    io.mkdir("a/b/c")
    io.mkdir("a/b/c")
    println(io.isDir("a/b/c"))
    io.writeFile("a/b/c/f.txt", "f")
    println(io.delete("a/b") + " " + io.delete("a/b/c/f.txt") + " " + io.delete("a/b/c") + " " + io.delete("a/b/c"))
    println(io.exists("a/b") + " " + io.exists("a/b/c"))
    println(io.delete("nope.txt"))
}
