// parseInt and toInt(string) give 0 for anything Integer.parseInt rejects;
// parseLong accepts what Long.parseLong does. No trimming; any Unicode
// decimal digit in the BMP counts.
fn main() {
    println(parseInt(""))
    println(parseInt("-"))
    println(parseInt("+"))
    println(parseInt("+5"))
    println(parseInt("-5"))
    println(parseInt(" 1"))
    println(parseInt("1 "))
    println(parseInt("2147483647"))
    println(parseInt("2147483648"))
    println(parseInt("-2147483648"))
    println(parseInt("-2147483649"))
    println(parseInt("9223372036854775808"))
    println(parseInt("99999999999999999999999"))
    println(parseInt("007"))
    println(parseInt("-0"))
    println(parseInt("+-1"))
    println(parseInt("--1"))
    println(parseInt("1_000"))
    println(parseInt("12a"))
    println(parseInt("0x10"))
    println(parseInt("1\0"))
    println(parseInt("٣٤"))
    println(parseInt("-٣٤"))
    println(parseInt("１２"))
    println(parseInt("۱२৩"))
    println(parseInt("𝟏"))
    println(parseInt("1²"))
    println(parseInt("Ⅻ"))
    println(toInt(""))
    println(toInt("+5"))
    println(toInt("2147483648"))
    println(toInt("-2147483648"))
    println(toInt("٣"))
    println(parseLong("0"))
    println(parseLong("+5"))
    println(parseLong("-5"))
    println(parseLong("2147483648"))
    println(parseLong("9223372036854775807"))
    println(parseLong("-9223372036854775808"))
    println(parseLong("٣٤٥٦٧٨٩٠١٢٣"))
    println(parseLong("-0"))
    println(parseLong("000000000000000000000000000001"))
}
