fn fib(n: int) -> int { if n < 2 { return n } return fib(n - 1) + fib(n - 2) }
fn fact(n: long) -> long { if n <= 1L { return 1L } return n * fact(n - 1L) }
fn isEven(n: int) -> bool { if n == 0 { return true } return isOdd(n - 1) }
fn isOdd(n: int) -> bool { if n == 0 { return false } return isEven(n - 1) }
fn gcd(a: int, b: int) -> int { if b == 0 { return a } return gcd(b, a % b) }
fn ackermann(m: int, n: int) -> int {
    if m == 0 { return n + 1 }
    if n == 0 { return ackermann(m - 1, 1) }
    return ackermann(m - 1, ackermann(m, n - 1))
}
fn depth(n: int) -> int { if n == 0 { return 0 } return 1 + depth(n - 1) }
fn main() {
    println(fib(20))
    println(fact(20L))
    println(fact(21L))
    println(isEven(1000))
    println(isOdd(7))
    println(gcd(1071, 462))
    println(ackermann(2, 3))
    println(depth(5000))
}
