// Aliasing: two names for one map, a map in a struct field and an array,
// arrays and structs stored as values and mutated in place.
struct Holder { m: Map<string, int> }
struct P { x: int }

fn bump(m: Map<string, int>, k: string) {
    m[k] += 1
}

fn main() {
    mut a: Map<string, int> = {"x": 1}
    imut b = a
    b["y"] = 2
    println(a)
    bump(a, "x")
    println(b)

    imut h = Holder { m: a }
    h.m["z"] = 3
    println(a)
    imut arr = [a, {"other": 0}]
    arr[0]["w"] = 4
    println(b)
    println(arr)
    a = {"fresh": 1}
    println(h.m)
    println(a)

    mut vals: Map<string, any> = {}
    imut xs = [1]
    vals["xs"] = xs
    push(xs, 2)
    println(vals)
    imut p = P { x: 1 }
    vals["p"] = p
    p.x = 9
    println(vals)
    imut inner: Map<string, int> = {"n": 1}
    vals["inner"] = inner
    inner["n"] = 2
    println(vals)
    imut held: any = vals
    imut again: Map<string, any> = held
    again["added"] = true
    println(vals)
}
