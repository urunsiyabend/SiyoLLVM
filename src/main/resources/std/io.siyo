// SiyoLLVM's std/io: the public signatures of SiyoCompiler 0.9.0's std/io.
// Every body here is a stub. The functions SiyoLLVM implements are native
// intrinsics in its C runtime (bound by this file's classpath identity,
// classpath:std/io.siyo); a call to any other is rejected at compile time.

pub fn readFile(path: string) -> string {
    error("SiyoLLVM intrinsic")
    return ""
}

// Writes a line to standard error, where a CLI's diagnostics belong.
pub fn eprintln(msg: string) {
    error("SiyoLLVM intrinsic")
}

